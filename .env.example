# Copy to .env and fill in. .env is gitignored — never commit it.
#
# --- required -------------------------------------------------------------
# Anthropic key for the brain. Create at console.anthropic.com.
# If every command suddenly fails identically, check the credit balance here
# before you suspect the code.
export ANTHROPIC_API_KEY=

# --- optional: Spotify ----------------------------------------------------
# Spotify app client ID (a public identifier, not a secret — ELCARS uses PKCE,
# so there is no client secret to leak). Register the redirect URI as exactly
# http://127.0.0.1:8888/callback — Spotify rejects "localhost".
# The refresh token lands in ~/elcars/.spotify.json (chmod 600), gitignored.
# Playback control needs Premium.
SPOTIFY_CLIENT_ID=

# --- optional: local places ----------------------------------------------
# Where find_places looks when you don't name somewhere. Leave blank and
# ELCARS will simply ask which area you mean.
#   ELCARS_HOME_AREA  the fallback area, specific enough to geocode
#   ELCARS_HOME_CITY  appended to a bare neighbourhood you speak aloud, so
#                     "find coffee in Zamalek" resolves to the right Zamalek
ELCARS_HOME_AREA=
ELCARS_HOME_CITY=
