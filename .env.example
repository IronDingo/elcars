# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Anthropic key for the brain. Create at console.anthropic.com.
export ANTHROPIC_API_KEY=

# Spotify app client ID (public identifier, not a secret).
# The OAuth refresh token lands in ~/elcars/.spotify.json (chmod 600),
# which is also gitignored.
SPOTIFY_CLIENT_ID=
